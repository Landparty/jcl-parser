//SORTJOB  JOB (9999),'SORT TEST',CLASS=S
//*
//* Standard DFSORT usage with SYSIN control cards
//*
//STEP1    EXEC PGM=SORT
//SORTIN   DD DSN=INPUT.DATA,DISP=SHR
//SORTOUT  DD DSN=OUTPUT.SORTED,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(50,10))
//SYSSOUT  DD SYSOUT=*
//SYSIN    DD *
  SORT FIELDS=(1,10,CH,A,20,5,PD,D)
  INCLUDE COND=(30,1,CH,EQ,C'Y')
  OPTION COPY
/*
//*
//STEP2    EXEC PGM=ICEMAN
//SYSIN    DD *
  MERGE FIELDS=(1,10,CH,A)
/*
