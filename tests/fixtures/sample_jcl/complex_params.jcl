//PARAMTST JOB (ACCT),'COMPLEX PARAMETERS'
//STEP1    EXEC PGM=IDCAMS
//SYSIN    DD *
  DELETE MY.OLD.FILE
  SET MAXCC=0
  DEFINE CLUSTER(NAME(MY.NEW.FILE) -
         VOLUMES(VOL001 VOL002) -
         RECORDSIZE(80 80) -
         KEYS(8 0) -
         INDEXED) -
         DATA(NAME(MY.NEW.FILE.DATA)) -
         INDEX(NAME(MY.NEW.FILE.INDEX))
/*
//DD1      DD DSN=FILE.ONE,DISP=SHR
//DD2      DD DSN=FILE.TWO,DISP=(NEW,CATLG),
//            SPACE=(CYL,(1,1)),
//            DCB=(DSORG=PS,RECFM=FB,LRECL=80,BLKSIZE=8000)
