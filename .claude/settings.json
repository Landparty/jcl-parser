{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "ruff format \"$CLAUDE_TOOL_INPUT_FILE_PATH\" 2>/dev/null; ruff check --fix --silent \"$CLAUDE_TOOL_INPUT_FILE_PATH\" 2>/dev/null; exit 0"
          },
          {
            "type": "command",
            "command": "python scripts/okf_staleness_check.py",
            "timeout": 10,
            "statusMessage": "Checking OKF freshness..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"$CLAUDE_TOOL_INPUT_FILE_PATH\" | grep -qE '(\\.coverage$|coverage\\.xml$|htmlcov/)' && echo '{\"decision\": \"block\", \"reason\": \"Blocked: generated file — do not edit directly\"}' && exit 0 || exit 0"
          }
        ]
      }
    ]
  }
}
